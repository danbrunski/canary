[Unit]
Description=Attach the CANary-HAT GNSS PPS to gpsd for chrony (H03.3)
Documentation=man:gpsd(8) man:gpsdctl(8) man:chrony.conf(5)
# The HAT's TIMEPULSE is a pps-gpio device whose kernel number moves with probe
# order, so 70-canary-pps.rules names it /dev/pps-canary and pulls this unit
# in. gpsd names the chrony socket after the path it was given
# (/run/chrony.pps-canary.sock), which is why this attaches the stable symlink
# rather than the template unit's %k: an instance name is either the moving
# ppsN or, unescaped, the path /dev/pps/canary.
#
# chrony reads the pulses through `refclock SOCK`, never `refclock PPS`:
# chronyd exits when a configured PPS device is missing, and a SOCK source
# without a writer is only an unusable source (install_pi.sh).
Requires=gpsd.socket
After=gpsd.socket
PartOf=gpsd.service
After=gpsd.service
BindsTo=dev-pps\x2dcanary.device
After=dev-pps\x2dcanary.device

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="GPSD_SOCKET=/run/gpsd.sock"
ExecStart=/usr/sbin/gpsdctl add /dev/pps-canary
ExecStop=/usr/sbin/gpsdctl remove /dev/pps-canary
