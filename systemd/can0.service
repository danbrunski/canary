[Unit]
Description=Bring up SocketCAN can0 for CANary capture
# Run before the canary daemon so the link exists when it opens the bus.
Before=canary.service
# can0 is the Waveshare 2-CH CAN HAT (MCP2515, SPI); appears as a net device
# once the mcp251x driver probes at boot.
BindsTo=sys-subsystem-net-devices-can0.device
After=sys-subsystem-net-devices-can0.device

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CAN_IFACE=can0
Environment=CAN_BITRATE=500000
# `restart-ms 100` = kernel auto-recovers the controller from CAN bus-off.
# The mcp251x (MCP2515) driver implements do_set_mode, so unlike the old
# gs_usb Canable it accepts IFLA_CAN_RESTART_MS. This is the link-layer
# companion to the recorder's app-level ReconnectPolicy
# (src/collection/can_collector.py).
ExecStart=/sbin/ip link set ${CAN_IFACE} type can bitrate ${CAN_BITRATE} restart-ms 100
ExecStart=/sbin/ip link set ${CAN_IFACE} up
ExecStop=/sbin/ip link set ${CAN_IFACE} down
# Don't fail the unit if the device is gone at stop time.
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
