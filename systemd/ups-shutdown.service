[Unit]
Description=CANary UPS (X1202) power-loss auto-shutdown watchdog
Documentation=https://wiki.geekworm.com/X1202
# Independent safety watchdog: deliberately NOT After/Requires canary.service,
# so it still powers the Pi down cleanly if the daemon is hung or dead.
After=multi-user.target
# The watchdog self-disarms if the UPS fuel gauge is absent; the only hard
# requirement is the GPIO chardev.
ConditionPathExists=/dev/gpiochip0

[Service]
Type=simple
# Runs as root: needs to read the GPIO chardev and to power the system off.
EnvironmentFile=/etc/canary/canary.env
# dtparam=i2c_arm=on enables the bus, but /dev/i2c-1 only appears once i2c-dev
# is loaded; ensure it so the UPS-present guard (fuel gauge at 0x36) can arm.
ExecStartPre=-/sbin/modprobe i2c-dev
# Tunables (see scripts/ups_shutdown_watch.py header for the full list):
Environment=UPS_PLD_GPIO=6
# 5-minute grace on battery before shutdown = the truck->bench transition
# budget (plug into bench power before it expires and it stays up).
Environment=UPS_SHUTDOWN_DELAY=300
Environment=UPS_I2C_ADDR=0x36
# Only power off while the battery is genuinely discharging, so bench-top USB-C
# power (PLD reads "no input" but the pack is idle) never trips a shutdown.
Environment=UPS_REQUIRE_DISCHARGE=1
Environment=UPS_MIN_DISCHARGE_RATE=6
Environment=UPS_CRITICAL_SOC=15
# Wider window/min-span so the big 4-cell pack's slow SoC drop is detectable.
Environment=UPS_DISCHARGE_WINDOW=120
Environment=UPS_DISCHARGE_MIN_SPAN=40
# Operator "keep alive N min" hold file (written by the dashboard/MCP).
Environment=UPS_KEEPALIVE_FILE=/run/canary/ups_keepalive
ExecStart=/usr/bin/python3 ${CANARY_HOME}/scripts/ups_shutdown_watch.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
