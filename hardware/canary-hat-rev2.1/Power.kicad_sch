	(text "POWER: OBD 12 V in (J2 pin 1, +12V_RAW) -> Q1 reverse block + D1 transient clamp -> +12V rail (also J2 pin 3, the X1202 feed).\n12 V sense divider R11/R12/C18 -> V12_SENSE (ADC CH0). U9 5 V sensor supply -> 5V_SENS (J2 pin 11, sensor ports).\nRev 3.0 moves the input chain to CANary-PWR (CANary-HAT-Revisions.md 13.3.0)."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b85bfebe-d243-4f4a-972c-95ff4a852814")
	)
