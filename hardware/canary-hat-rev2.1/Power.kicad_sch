		(property "Description" "Polarized capacitor"
			(at 138.43 120.65 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "D1 (SMBJ24A) clamps at ~38.9V, so 50V is the floor for anything on +12V - dropping to 25V makes 100uF fit this footprint and fails on the first load dump. REV 2.0: value corrected 100uF -> 47uF. 100uF/50V does not exist in a 6.3mm can (smallest standard case is 8x11.5mm on 3.5mm pitch); at D6.3mm/P2.50mm the largest standard 50V value is 47uF - Panasonic EEU-FR1H470 or Nichicon UPW1H470MED. The value was changed to match the footprint, not the reverse: 6.3mm is right for a rail carrying tens of mA and board area is needed for the rev 3.0 MCU. Capacitance is not load-bearing here - C3 is the part the TLIN1027 datasheet requires and D1 does the transient clamping; C2 only shaves the leading edge before the TVS conducts (22mV sag at 47uF vs 11mV at 100uF on one dominant bit). Populate/DNP is a bring-up call: if the TLIN1027 upsets or resets during cranking or hot-plug, populating C2 is the first thing to try."
			(at 142.24 118.4909 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
		(property "Temp_Rating" "105C"
			(at 142.24 118.4909 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
