		(property "Description" "TVS diode, 24V standoff, SMB (DO-214AA)"
			(at 121.92 120.65 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Note" "Input transient clamp, and the part that sets a board-wide rule. Vwm 24.0V, Vbr 26.70-29.50V at 1 mA, MAXIMUM CLAMPING VOLTAGE 38.9V at 15.5A - so 50V is the floor for the rating of anything on the +12V net (C2, C3), not the 12-14.4V the rail actually sits at. 24V standoff is the correct automotive choice: a 14V-standoff part would operate at or above standoff during ordinary driving. REV 2.0 moved this ahead of the J3 fan-out, so it now clamps the Pi's supply as well as the HAT's - closing the exposure S3.7.4 had accepted. Q1 does NOT subsume it: a P-FET in reverse protection is fully ON during a positive transient and conducts a load dump straight through."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
		(property "MPN" "SMBJ24A"
			(at 124.46 119.3799 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
