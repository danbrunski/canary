	(text "U8 ADS8688A on SPI0 CE1, SPI mode 1 (CPOL 0, CPHA 1; Linux ti-ads8688). SDO tri-states with CS high, so it shares MISO with U3.\nALARM (pin 35) unused. Internal 4.096 V reference: REFSEL low; REFIO/REFCAP start-up 15 ms."
		(exclude_from_sim no)
		(at 270 110 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1bccfe2d-26d0-41c0-8ae1-205017355db7")
	)
	(text "U8 REFERENCE + SUPPLY DECOUPLING (SBAS680 sec. 10-11): all at the pins, no vias on REFCAP."
		(exclude_from_sim no)
		(at 270 65 0)
		(effects
