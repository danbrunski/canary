		(property "MPN" "RC0603FR-071ML"
			(at 0 0 180)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "cf5468b4-53eb-4fbc-8ac4-125a421e36c5")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.15)
				)
			)
		)
		(property "Note" "EN divider bottom. U9 EN circuit (review M1, 2026-10-12): EN = +12V/2 via R17/R44 (1M/1M), so EN <= IN by construction; Q4 holds EN at GND by default (gate biased from +12V by R45/R46), Q5 releases it when SENS_PWR_EN (GPIO19, J1 pin 35) is driven high. GPIO low, undriven or Pi off = sensor supply OFF; software turns it on (and can turn it off when parked). C32 sets the EN slew (< 1.5 V/us); D10 clamps EN to IN + ~0.2 V while +12V collapses faster than the 0.5 ms EN time constant. Replaces R17 330k from +3V3 + D10, whose hot leakage (up to 20 uA at 60 C) turned U9 on with the Pi off."
			(at 0 0 180)
			(unlocked yes)
			(layer "F.Fab")
			(hide yes)
			(uuid "bf8111fc-7af9-422b-bde7-092cafbac649")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.15)
				)
			)
		)
