		)
		(property "Datasheet" ""
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "54446b70-66af-4e3c-8c94-16808fd3a705")
			(effects
				(font
					(size 0.8 0.8)
