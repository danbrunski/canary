		(property "Description" "LIN / K-line transceiver, no dominant state timeout, 4-36V VSUP, SOIC-8"
			(at 140.97 73.66 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
		(property "Note" "K-line / LIN transceiver, chosen for having NO dominant-state timeout so 5-baud slow init is possible. VSUP 4-36V operating, absolute max -0.3 to +45V - that 45V is what D1's 38.9V clamp is sized against. Rated for ISO 7637-2 Pulse 1 -100V / Pulse 2 +75V on LIN and VSUP. EN (pin 2, GPIO26) has a strict startup order - see S11: blank RXD ~50 us after raising EN, open the tty before raising EN, drop EN before releasing it including on crash paths. Power-up lands in standby with RXD driven low, which is a continuous serial break - disable the console on uart0 or magic SysRq can kill the host."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
		(property "Manufacturer" "Texas Instruments"
			(at 140.97 73.66 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
