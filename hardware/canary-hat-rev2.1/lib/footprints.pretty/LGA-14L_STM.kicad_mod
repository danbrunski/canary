(footprint "LGA-14L_STM"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "LSM6DSOX LGA-14. REV 2.0: lands revised to the ST TN0018 recommended pattern, 0.350 x 0.575 mm with +0.025 mm/side solder-mask expansion (mask openings 0.40 x 0.625 mm, 0.10 mm dams). Previously 0.3048 x 0.5334 mm, ~19% under-area, an accepted solder-joint reliability compromise while rev 1.0 was locked. Minimum pad-to-pad gap is now 0.150 mm against the 0.14 mm rule in canary-hat.kicad_dru - re-run DRC after Update Footprints from Library.")
