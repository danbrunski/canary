(version 1)
(rule "U6 LGA-14L land pattern"
	(constraint clearance (min 0.14mm))
	(condition "A.insideCourtyard('U6') && B.insideCourtyard('U6')"))
(rule "RF feed"
(constraint clearance (min 0.5mm))
(condition "(A.NetClass == 'RF' && B.Type == 'Zone') || (B.NetClass == 'RF' && A.Type == 'Zone')"))
(rule "+12V_RAW carries the rig's ~3 A"
	(constraint track_width (min 1.2mm))
	(condition "A.NetName == '/+12V_RAW'"))
(rule "U9 DGN land pattern"
	(constraint clearance (min 0.15mm))
	(condition "A.insideCourtyard('U9') && B.insideCourtyard('U9')"))
(rule "Fine-pitch neck-down: U8 TSSOP-38 and U6 LGA-14 (0.5 mm), U9 VSSOP-8 (0.65 mm)"
	(constraint track_width (min 0.15mm) (opt 0.25mm))
	(condition "A.insideCourtyard('U8') || A.insideCourtyard('U9') || A.insideCourtyard('U6')"))
