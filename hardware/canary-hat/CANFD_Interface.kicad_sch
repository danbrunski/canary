			)
		)
		(property "Note" "D6 CAN-activity LED series resistor. (3.3 - 1.95 Vf - 0.3 Vol)/1k = ~1.05 mA peak with the specified Kingbright APT1608SURCK. Sized to stay inside the TCAN1042 RXD drive spec (Vol <= 0.2 x VIO at 2 mA) and to leave margin against the MCP2518FD RXCAN input threshold (Vil = 0.3 x VDD = 0.99V vs RXD's worst-case Vol of 0.66V at 2 mA). Do not reduce below ~680R: this LED hangs on the working CAN receive path."
			(at 0 0 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
