	(text "CANary cap bank rev 1.0 -- four 25 F cells for CANary-PWR's LTC3350"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "8b93aadf-e698-4d7c-9d78-4a1e619e6df9")
	)
	(text "Four 25 F cells in series, run at 2.5 V each (10 V stack), charged and balanced by CANary-PWR's LTC3350.\nCell 1 is the bottom cell (LTC3350 CAPRTN..CAP1), cell 4 the top (CAP3..CAP4). GND is the stack's bottom plate.\nInter-cell joins carry the full 4 A (7.25 A peak): pours on both layers. The taps to J1 carry only the shunt current (<= 0.5 A).\nKelvin sense: NT1 and NT2 join BANK_POS_S / BANK_NEG_S to the stack at the cell leads themselves.\nThe lead: 43025-1000 at both ends, wired pin n to pin n; pin map in hardware/tools/capbank_lead.py, shared with CANary-PWR J4.\nDISCHARGE BEFORE UNPLUGGING: lower vshunt on CANary-PWR (bench button held, or I2C) until the red LED goes out."
		(exclude_from_sim no)
		(at 20.32 55.88 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "93c6dfa4-7027-4e76-892c-5707d66d0a66")
	)
