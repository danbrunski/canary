#!/usr/bin/env bash
# Tracked pre-push hook: refuses to push a commit the full CI gate has not
# passed on. The gate itself runs in scripts/ci_gate.sh (usually via
# scripts/push.sh) BEFORE the push, because git opens the connection to GitHub
# before this hook runs and GitHub closed it during a ~7 min in-hook gate
# (2026-09-23). This hook only checks for the green stamp that ci_gate.sh
# writes for the exact commit, so it takes milliseconds.
#
# Enable once per clone:   git config core.hooksPath scripts/git-hooks
# Push:                    scripts/push.sh        (gates, then pushes)
# Bypass (emergencies):    git push --no-verify   -- then: gh run watch
set -uo pipefail
stamp_dir="$(git rev-parse --git-common-dir)/ci-gate"
zero=0000000000000000000000000000000000000000
refuse=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue                       # deletion
  [[ -f "$stamp_dir/$local_sha" ]] && continue                     # gated green
  if [[ "$remote_sha" != "$zero" ]] \
     && ! git diff --name-only "$remote_sha" "$local_sha" \
          | grep -qvE '(\.mdx?$|^docs/|^README|^CHANGELOG|^LICENSE)'; then
    continue                                                       # docs only
  fi
  echo "✗ pre-push: ${local_sha:0:7} ($local_ref) has not passed the CI gate." >&2
  refuse=1
done
if [[ $refuse -ne 0 ]]; then
  echo "  Run scripts/push.sh (gates in a worktree, ~7 min, then pushes)," >&2
  echo "  or scripts/ci_gate.sh <commit> and push again." >&2
  exit 1
fi
exit 0
