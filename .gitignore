# CANary telemetry artifacts (not committed; can be large)
*.parquet
*.jsonl
*.log
logs/
data/sessions/
data/raw/
# Laptop training mirror: sessions rsync'd off the Pi by scripts/sync-train.sh.
/sessions/
# control-plane tokens, audit log, job ledger — never commit
data/control/

# Vendor FSM PDFs — copyrighted, not committable; extracted name lists land
# in data/fsm/ which IS committed (factual identifiers).
xterra_fsm/

# Trained model artifacts (not committed; manifests live alongside the binary).
# Recursive — models live in per-type subdirs (models/isolation_forest/…).
models/**/*.pt
models/**/*.pth
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/*.pt
models/*.pth
models/*.pkl
