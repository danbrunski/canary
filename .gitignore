# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
build/
dist/
sdist/
wheels/
.eggs/
develop-eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
.hypothesis/

# Type checking & lint caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local config & secrets — copy canary.example.yaml to canary.yaml and edit
.env
.env.*
canary.yaml
# Live Pi config pulled by scripts/sync-train.sh for exact-match preprocessing
# (may contain the vehicle VIN — never commit).
canary.laptop.yaml
# Local copy of the Pi's serve config (scp'd from /etc/canary/canary.yaml) used
# to train with serve-time params; machine-specific device paths — never commit.
canary.train.yaml

# CANary telemetry artifacts (not committed; can be large)
*.parquet
*.jsonl
# Small sanitized protocol transcripts are regression fixtures, not telemetry.
!tests/fixtures/uprev_usb/*.jsonl
*.log
logs/
data/sessions/
data/raw/
data/cache/
# Laptop training mirror: sessions rsync'd off the Pi by scripts/sync-train.sh.
/sessions/
# Laptop pull of the Pi's live session dirs (telemetry parquet + control/
# classification json sidecars); large, never committed.
/pi_sessions/
# control-plane tokens, audit log, job ledger — never commit
data/control/

# Vendor FSM PDFs — copyrighted, not committable; extracted name lists land
# in data/fsm/ which IS committed (factual identifiers).
xterra_fsm/

# Trained model artifacts (not committed; manifests live alongside the binary).
# Recursive — models live in per-type subdirs (models/isolation_forest/…).
models/**/*.pt
models/**/*.pth
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
models/*.onnx
# Underscore-prefixed dirs are scratch (bake-off / replay output), excluded
# everywhere else by the leading-`_` convention — keep them out of git too.
models/_*/

# Claude Code local/runtime state (settings.json, hooks, agents, commands ARE versioned)
.claude/overnight-mode
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Ground-truth regression fixture: a small slice of a real session, committed
# deliberately so tests/test_analysis_ground_truth.py can check the analysis
# chain against answers we already know. Real bytes off the wire — a
# synthesised fixture would only prove the chain agrees with itself.
!tests/fixtures/**/*.parquet

# ── KiCad hardware project (hardware/canary-hat) ──────────────────────────
# The board design is tracked so the claims docs/CANary-HAT-*.md make about it
# are checkable — kicad-cli can run against any commit to regenerate a netlist
# and diff it. Datasheets are tracked too: six rev 2.0 decisions turned on
# reading them, and vendor PDFs get revised and pulled. What follows is churn,
# machine-local state, or regenerable output.

# VS Code local history — 66 MB of editor churn, no value here
hardware/**/.history/

# KiCad auto-backups and lock files
hardware/**/*-backups/
hardware/**/*.lck

# Machine-local UI state, not design data
hardware/**/*.kicad_prl

# Regenerable cache
hardware/**/fp-info-cache

# Autorouter I/O — regenerated from the PCB on demand
hardware/**/freerouting.dsn
hardware/**/freerouting.ses
hardware/**/temp-freerouting.dsn

# Snapshot archive superseded by git history
hardware/**/*.kicad_pcb.zip

# Scratch exports from a working session. Deliberate dated snapshots such as
# DRC-fresh.rpt stay tracked.
hardware/**/_*.net
hardware/**/_*.rpt
hardware/**/_*.pdf

# NTFS alternate data streams ("downloaded from the internet" marks). These
# materialise as separate files when a Windows directory is copied into WSL.
*:Zone.Identifier

# Live-pipeline microbenchmark reports (scripts/benchmark_live_pipeline.py
# --report default). Underscore-prefixed so session discovery skips it; the
# curated baselines live under data/analyses/ instead.
data/_benchmarks/

# C10 sustained-validation raw sessions (scripts/sustained_validation.py
# --sessions-root default). Underscore-prefixed so training discovery and the
# retention sweep skip them; the curated reports live under
# data/analyses/sustained-validation/ instead.
data/_validation/

# Behavior refits keep the replaced artifact here (B03.10); local recovery copies.
data/*/_prior/
data/*/_candidates/
